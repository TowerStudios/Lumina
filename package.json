{
  "name": "lumina",
  "version": "0.1.0",
  "description": "Lumina - WeChat data analysis desktop tool with elegant UI",
  "main": "dist-electron/main.js",
  "author": {
    "name": "MarkCKB"
  },
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps && node scripts/prepare-electron-runtime.cjs",
    "rebuild": "electron-rebuild",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "vite --mode electron",
    "electron:build": "npm run build"
  },
  "dependencies": {
    "@markckb/electron-liquid-glass": "file:vendor/electron-liquid-glass",
    "@vscode/sudo-prompt": "^9.3.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.3.0",
    "fzstd": "^0.1.1",
    "html2canvas": "^1.4.1",
    "jieba-wasm": "^2.2.0",
    "jszip": "^3.10.1",
    "koffi": "2.16.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-virtuoso": "^4.18.10",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^1.13.3",
    "silk-wasm": "^3.7.1",
    "tar": "^7.5.19",
    "wechat-emojis": "^1.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "build": {
    "appId": "com.markckb.lumina",
    "productName": "Lumina",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "resources/icons/macos/icon.icns",
      "extraResources": [
        {
          "from": "resources/wcdb/macos/universal",
          "to": "resources/wcdb/macos/universal"
        },
        {
          "from": "resources/key/macos/universal",
          "to": "resources/key/macos/universal"
        }
      ]
    },
    "win": {
      "target": ["nsis"],
      "icon": "public/icon.ico",
      "executableName": "weflow",
      "extraResources": [
        {
          "from": "resources/wcdb/win32/${arch}",
          "to": "resources/wcdb/win32/${arch}"
        },
        {
          "from": "resources/key/win32",
          "to": "resources/key/win32",
          "filter": ["${arch}/**/*"]
        },
        {
          "from": "resources/runtime/win32",
          "to": "resources/runtime/win32"
        }
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "target": ["appimage", "tar.gz"],
      "category": "Utility",
      "executableName": "lumina",
      "synopsis": "Lumina for Linux",
      "extraResources": [
        {
          "from": "resources/wcdb/linux/${arch}",
          "to": "resources/wcdb/linux/${arch}"
        },
        {
          "from": "resources/key/linux",
          "to": "resources/key/linux",
          "filter": ["${arch}/**/*"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "differentialPackage": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "unicode": true,
      "installerLanguages": ["zh_CN", "en_US"],
      "language": "2052",
      "displayLanguageSelector": false,
      "perMachine": false,
      "allowElevation": true
    },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "asarUnpack": [
      "node_modules/silk-wasm/**/*",
      "node_modules/sherpa-onnx-node/**/*",
      "node_modules/sherpa-onnx-*/*",
      "node_modules/sherpa-onnx-*/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/@markckb/electron-liquid-glass/**/*",
      "vendor/electron-liquid-glass/**/*"
    ]
  }
}
